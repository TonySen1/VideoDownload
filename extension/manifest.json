{
  "manifest_version": 3,
  "name": "VideoDownload 助手",
  "version": "1.3.2",
  "description": "在支持的视频平台页面上，一键把链接发送到 VideoDownload 桌面程序解析下载。",
  "minimum_chrome_version": "105",
  "permissions": ["tabs", "storage", "alarms", "cookies"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "https://vimeo.com/*",
    "https://*.vimeo.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://stashmedia.tv/*",
    "https://*.stashmedia.tv/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/pill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VideoDownload 助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
